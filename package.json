{
  "name": "schedule-site-shared-state-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run vercel-build",
    "build:english-travel": "esbuild scripts/english-rpg/game.js --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=english-travel-3d.bundle.js",
    "test:english-travel": "node --test test/english-travel-speech.test.cjs test/english-travel-village.test.cjs test/english-rpg.test.cjs",
    "vercel-build": "npm run build:english-travel && npm run build:kitty-room && node scripts/vercel-stamp-admin-index.cjs && node scripts/vercel-materialize-public.cjs",
    "start": "node server.js",
    "docker:style-web": "docker build -t schedule-style-web .",
    "delivery:preview": "node tools/delivery-folder-preview.cjs",
    "delivery:run-once": "node tools/run-delivery-drive-once.cjs",
    "delivery:provision-company-all": "node tools/company-drive-provision-all.cjs",
    "delivery:provision-company-all-naver": "node tools/company-drive-provision-all.cjs",
    "delivery:provision-company-retry": "node tools/company-drive-provision-all.cjs -- \ub514\uc790\uc778\uc5f0\ub2f4 \uc544\ub780\ub514\uc790\uc778 \uc7a5\uc120\uc6b0\ub300\ud45c\ub2d8 \uacf5\uac04\ub514\uc790\uc778\ube44\uc6c0 \ub514\uc54c",
    "naverworks:venv": "bash scripts/setup-naverworks-venv.sh",
    "delivery:backfill-apr27-may5-2026": "node tools/delivery-backfill-apr27-may5-2026.cjs",
    "drive:rename-company-suffix": "node tools/rename-drive-company-folder-suffix.cjs",
    "build:kitty-room": "esbuild scripts/kitty-life/room3d.js --bundle --format=iife --minify --outfile=scripts/kitty-life/room3d.bundle.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "latest",
    "express": "latest",
    "googleapis": "^144.0.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "playwright": "^1.58.2"
  }
}
